{
  "name": "lol-overlay",
  "version": "0.33.8",
  "description": "Overlay de itemização ao vivo para League of Legends",
  "author": "Gabriel",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:mock": "electron . --mock",
    "mock": "node mock/mockServer.js",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "dist:zip": "electron-builder --win zip",
    "dist:local": "node scripts/build-installer.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "build": {
    "appId": "com.gabriel.loloverlay",
    "productName": "LoL Overlay",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "data/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LoL Overlay",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "LoL-Overlay-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gabtavarez",
        "repo": "lol-overlay",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-html-parser": "^6.1.13",
    "uiohook-napi": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gabtavarez/lol-overlay.git"
  }
}
